APP_PORT=8080
# Absolute PEM paths outside the repository; keep the private key owner-readable only.
APP_JWT_PRIVATE_KEY_FILE=
APP_JWT_PUBLIC_KEY_FILE=
# Initial ADMIN credentials; no shared password. Existing passwords are never overwritten.
APP_BOOTSTRAP_ADMIN_LOGIN=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Local loopback HTTP only. Set true when serving the application through HTTPS.
AUTH_REFRESH_COOKIE_SECURE=false
DB_NAME=clothes_advisor
DB_USER=clothes_advisor
DB_PASSWORD=local-only-change-me
ACCOUNT_DB_PASSWORD=local-account-only-change-me
SPRING_PROFILES_ACTIVE=local
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
# Absolute authorized service-account JSON key file, outside the repository.
YANDEX_SERVICE_ACCOUNT_KEY_FILE=
# Credential owner UID: run id -u on the host.
APP_UID=
# Absolute private login directory outside the repository (chmod 700); only refresher mounts it.
# Login records must be owner-only files (chmod 600); cert-only PKCS12 may also be 644.
CHATGPT_CREDENTIALS_DIR=
OPENAI_MODEL=
# Optional PKCS12 path inside the container, e.g. /run/chatgpt/truststore-corporate.p12.
CHATGPT_TRUST_STORE=
