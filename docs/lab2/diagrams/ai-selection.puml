@startuml ai-selection
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

actor "Frontend\nчерез Gateway" as client
participant "wardrobe-service" as wardrobe
participant "account-service" as account
database "wardrobe_db" as db
participant "Yandex S3" as s3
participant "recommendation-service" as recommendation
participant "OpenAI" as ai

client -> wardrobe : POST /api/outfits/ai или\n/api/outfits/{id}/ai-replacements\nIdempotency-Key — необязательный
wardrobe -> account : Текущий пользователь · проверка ACTIVE
account --> wardrobe : id, login, role, status
wardrobe -> account : Свежие сведения для допуска к AI
account --> wardrobe : id, login, role, status
wardrobe -> wardrobe : Проверить ACTIVE USER и личный допуск

opt Передан Idempotency-Key
  wardrobe -> db : Захватить ключ + отпечаток · RUNNING\nОтдельная короткая транзакция
  db --> wardrobe : Новая команда или существующая запись
  break Повтор или конфликт ключа
    wardrobe --> client : SUCCEEDED: исходный 201 + JSON + Location\nИначе: 409 · без S3 и AI
  end
end
wardrobe -> wardrobe : Попытаться занять единственный слот

alt Слот уже занят
  wardrobe --> client : 503 · без S3 и AI
else Слот занят этим запросом
  group Короткая транзакция чтения
    wardrobe -> db : Кандидаты, первое фото, погода, профиль\nПри замене: исходный образ и обязательные ID
    db --> wardrobe : 1–20 кандидатов + photoId + снимок предпочтений
  end

  group Сетевые вызовы — вне JDBC-транзакций
    loop Для каждого кандидата
      wardrobe -> account : Проверить активность
      account --> wardrobe : Разрешено
      group Короткая транзакция чтения метаданных
        wardrobe -> db : Проверить вещь и исходное фото
        db --> wardrobe : Ключ S3, тип и размер
      end
      wardrobe -> s3 : Получить фото
      s3 --> wardrobe : Байты JPEG / PNG
      group Короткая транзакция повторного чтения
        wardrobe -> db : Проверить вещь и исходное фото
        db --> wardrobe : Фото существует
      end
      wardrobe -> account : Проверить активность после S3
      account --> wardrobe : Разрешено
    end
    wardrobe -> account : Проверить активность перед AI
    account --> wardrobe : Разрешено
    wardrobe -> recommendation : POST /api/outfit-selections\nПогода + разовые пожелания + профиль\nКандидаты + фото; при замене: requiredItemIds
    recommendation -> ai : Подбор · таймаут 60 с · без повторов
    ai --> recommendation : Успешно завершённый ответ
    recommendation --> wardrobe : 200 · itemIds + explanation
    wardrobe -> wardrobe : Проверить ID, выбор и объяснение\nПри замене: сохранены обязательные, есть новые
    wardrobe -> account : Финальная проверка активности
    account --> wardrobe : Разрешено
  end

  note over wardrobe, account #FFF0D6
    После этой проверки блокировка пользователя
    не отменяет уже разрешённое сохранение.
  end note

  group Одна локальная JDBC-транзакция
    wardrobe -> db : Заблокировать все исходные вещи\nПроверить все использованные photoId
    opt Замена части образа
      wardrobe -> db : Заблокировать исходный образ\nОтсутствует —409
    end
    db --> wardrobe : Данные существуют
    wardrobe -> db : Образ + пожелания + объяснение\nСостав + погода; при ключе: SUCCEEDED + ответ
    db --> wardrobe : Commit · сохранённые ID и даты
  end
  wardrobe -> wardrobe : Освободить слот
  wardrobe --> client : 201 · OutfitResponse · Location
end

note over wardrobe, recommendation
  Ошибка до сохранения: прервать сценарий, образа нет.
  Ошибка записи: rollback. Слот освобождается при завершении.
  При ошибке команда становится FAILED; падение может оставить RUNNING.
  Повтор с таким ключом не запускает сценарий снова.
  Отмена HTTP не отменяет уже выполненный commit.
end note
@enduml
