{
  "uid": "ca-runtime",
  "title": "Clothes Advisor · JVM",
  "description": "Начните с CPU и памяти. Если при росте задержки растёт доля времени в GC или число заблокированных потоков, проверьте выбранную JVM в логах и трассах.",
  "tags": ["clothes-advisor"],
  "schemaVersion": 39,
  "editable": false,
  "timezone": "browser",
  "time": {"from": "now-30m","to": "now"},
  "refresh": "15s",
  "links": [
    {
      "type": "dashboards",
      "title": "Дашборды Clothes Advisor",
      "tags": ["clothes-advisor"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "JVM-сервис",
        "type": "query",
        "datasource": {"type": "prometheus","uid": "prometheus"},
        "query": {"query": "label_values(jvm_memory_used_bytes, job)","refId": "variable"},
        "definition": "label_values(jvm_memory_used_bytes, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": "wardrobe-service","value": "wardrobe-service"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU процесса",
      "description": "Доля доступного CPU, занятая процессом JVM. 100% — вся доступная ему вычислительная ёмкость, а не одно ядро.",
      "gridPos": {"x": 0,"y": 0,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "process_cpu_usage{job=~\"${service:regex}\"}","legendFormat": "{{job}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit","min": 0,"max": 1},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Память heap: занята и выделена",
      "description": "Сумма пулов heap. Выделенная память (committed) уже предоставлена JVM; это не предел -Xmx.",
      "gridPos": {"x": 12,"y": 0,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "sum by (job) (jvm_memory_used_bytes{job=~\"${service:regex}\",area=\"heap\"})","legendFormat": "{{job}} · занята"},
        {"refId": "B","expr": "sum by (job) (jvm_memory_committed_bytes{job=~\"${service:regex}\",area=\"heap\"})","legendFormat": "{{job}} · выделена"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Время в паузах GC",
      "description": "Доля времени в stop-the-world паузах. Окно — интервал rate. Фоновая конкурентная работа GC не включена.",
      "gridPos": {"x": 0,"y": 8,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "sum by (job) (rate(jvm_gc_pause_milliseconds_sum{job=~\"${service:regex}\"}[$__rate_interval])) / 1000","legendFormat": "{{job}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Средняя длительность паузы GC",
      "description": "Суммарная длительность, делённая на число пауз. При отсутствии сборок за окно нет значения.",
      "gridPos": {"x": 12,"y": 8,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "sum by (job) (rate(jvm_gc_pause_milliseconds_sum{job=~\"${service:regex}\"}[$__rate_interval])) / sum by (job) (rate(jvm_gc_pause_milliseconds_count{job=~\"${service:regex}\"}[$__rate_interval]))","legendFormat": "{{job}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Потоки JVM по состояниям",
      "description": "Состояние blocked означает ожидание монитора. Waiting и timed-waiting сами по себе не означают перегрузку.",
      "gridPos": {"x": 0,"y": 16,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "jvm_threads_states{job=~\"${service:regex}\"}","legendFormat": "{{job}} · {{state}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Память вне heap",
      "description": "Metaspace, кэш кода и другие non-heap пулы JVM. Не включает всю нативную память процесса.",
      "gridPos": {"x": 12,"y": 16,"w": 12,"h": 8},
      "datasource": {"type": "prometheus","uid": "prometheus"},
      "targets": [
        {"refId": "A","expr": "sum by (job) (jvm_memory_used_bytes{job=~\"${service:regex}\",area=\"nonheap\"})","legendFormat": "{{job}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list","placement": "bottom"},
        "tooltip": {"mode": "multi","sort": "desc"}
      }
    }
  ]
}
